# Copia a .env y ajusta. Ver también variables existentes (MONGODB_URI, SEND_JWT_SECRET, …)

# Formulario de la landing: notificación por WhatsApp vía ser-wp (mismo servicio que SERWP_SEND_URL)
# Solo dígitos, varios destinatarios separados por comas (sin espacios obligatorios; se ignoran no-dígitos)
NumberListWhats=573001112233,573004445556

# URL del API send de ser-wp (por defecto localhost)
# SERWP_SEND_URL=http://127.0.0.1:8444/api/send

# Microservicio masssivo-qr-wa (Baileys, QR) — misma clave que INTERNAL_SERVICE_KEY del microservicio
# MASSIVO_QR_WA_URL=http://127.0.0.1:3840
# MASSIVO_QR_WA_KEY=
